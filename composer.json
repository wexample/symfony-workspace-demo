{
  "name": "wexample/symfony-workspace-demo",
  "version": "2.1.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyWorkspaceDemo\\": "src/"
    }
  },
  "description": "Demo pages of symfony-workspace",
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyWorkspaceDemo\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=43.0.0",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=27.0.0",
    "wexample/symfony-workspace": ">=2.1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}