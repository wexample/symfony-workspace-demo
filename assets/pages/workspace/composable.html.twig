{%- extends '@WexampleSymfonyWorkspaceDemoBundle/pages/workspace/layout/layout-workspace.html.twig' -%}
{%- import '@WexampleSymfonyWorkspaceDemoBundle/partials/nav.html.twig' as nav -%}

{%- set page_body_mode = 'wide' -%}

{%- block page_body_container -%}
    {#- What the page offers before the visitor arranges anything: colours
        beside what they are told, a note under it. Every zone is cut again,
        sized, given another widget once the board is being arranged; the
        arrangement is kept. -#}
    {%- set default_layout = {
        id: 'root', split: 'h', size: 1, children: [
            { id: 'colors', size: 1, widget: 'demo-color' },
            { id: 'side', split: 'v', size: 1, children: [
                { id: 'swatch', size: 1, widget: 'demo-swatch' },
                { id: 'note', size: 1, widget: 'demo-note' },
            ] },
        ],
    } -%}
    <div class="zone zone--split">
        {{ nav.layouts(render_pass, 'composable') }}
        {#- The board alone, its own bar at its top: no title over it. -#}
        <div class="zone">
            {{ vue(render_pass, '@WexampleSymfonyWorkspaceBundle/components/workspace-board', workspace_board('demo-composable', {
                widgets: ['demo-color', 'demo-swatch', 'demo-note'],
                layout: default_layout,
            })) }}
        </div>
    </div>
{%- endblock -%}
