{%- extends '@front/layouts/private/layout.html.twig' -%}
{%- import '@WexampleSymfonyWorkspaceDemoBundle/partials/slide.html.twig' as deck -%}

{#- One slide, as the centre of the editor shows it: as wide as the room
    allows while its proportions fit, in the middle of it. -#}
{%- block page_body -%}
    <div class="page--fill">
        <div class="workspace-slide--room">
            <div class="container--center">
                {{ deck.slide(
                    render_pass,
                    ('@page::slide.' ~ slide ~ '.title') | trans,
                    ('@page::slide.' ~ slide ~ '.body') | trans,
                    '@page::position' | trans({ '%position%': position, '%count%': count }),
                    'workspace-slide'
                ) }}
            </div>
        </div>
    </div>
{%- endblock -%}
