{%- extends '@WexampleSymfonyWorkspaceDemoBundle/pages/workspace/layout/layout-workspace.html.twig' -%}
{%- import '@WexampleSymfonyWorkspaceDemoBundle/partials/nav.html.twig' as nav -%}

{%- set page_body_mode = 'wide' -%}

{%- block page_body_container -%}
    <div class="zone zone--split">
        {{ nav.layouts(render_pass, 'columns') }}
        {#- The row itself: five regions wider than any screen, and the split
            scrolling sideways rather than squeezing them. The navigation stays
            out of it — it is a region of the page, not one of the columns. -#}
        <div class="zone zone--split zone--split--scroll">
            {%- set first %}
                <h1 class="workspace-columns--title">{{ page_title|default(null) ?: '@page::page_title'|trans }}</h1>
                <p class="lead">{{ '@page::intro' | trans }}</p>

                <h2>{{ '@page::section.scroll.title' | trans }}</h2>
                <p>{{ '@page::section.scroll.description' | trans }}</p>

                <h2>{{ '@page::section.width.title' | trans }}</h2>
                <p>{{ '@page::section.width.description' | trans }}</p>

                <h2>{{ '@page::section.fold.title' | trans }}</h2>
                <p>{{ '@page::section.fold.description' | trans }}</p>
                <p>{{ '@page::section.fold.more' | trans }}</p>
            {% endset -%}
            {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-collapsible', {}, {
                id: 'demo.columns.read',
                title: '@page::column.first' | trans,
                class: 'workspace-columns--column',
                slots: { body: first }
            }) }}

            {%- for step in ['second', 'third', 'fourth'] -%}
                {%- set body %}
                    <div class="stack--vertical">
                        {%- for i in 1..3 -%}
                            <div class="block block--padded">
                                <strong>{{ ('@page::card.' ~ step) | trans }} {{ i }}</strong>
                                <p>{{ '@page::card.body' | trans }}</p>
                            </div>
                        {%- endfor -%}
                    </div>
                {% endset -%}
                {%- set count %}<span class="count">3</span>{% endset -%}
                {#- The third one opens folded, so the page shows both states at
                    once and the memory has something to remember. -#}
                {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-collapsible', {}, {
                    id: 'demo.columns.' ~ step,
                    title: ('@page::column.' ~ step) | trans,
                    collapsed: step == 'third',
                    class: 'workspace-columns--column',
                    slots: { body: body, actions: count }
                }) }}
            {%- endfor -%}

            {#- The last one is a vue, and nothing about it reads differently:
                same component, same classes, same key in the ui state. -#}
            <div class="zone workspace-columns--column">
                {{ vue(render_pass, '@WexampleSymfonyWorkspaceDemoBundle/components/demo-collapsible-column', {
                    stateId: 'demo.columns.fifth',
                    title: '@page::column.fifth' | trans,
                    body: '@page::card.body' | trans,
                    items: [
                        '@page::card.fifth' | trans ~ ' 1',
                        '@page::card.fifth' | trans ~ ' 2',
                        '@page::card.fifth' | trans ~ ' 3'
                    ]
                }) }}
            </div>
        </div>
    </div>
{%- endblock -%}
