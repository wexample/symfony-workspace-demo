{%- extends '@front/layouts/private/layout.html.twig' -%}
{%- import '@WexampleSymfonyWorkspaceDemoBundle/partials/slide.html.twig' as deck -%}

{%- set page_body_mode = 'wide' -%}

{#- Three regions and one channel. The rail is rendered by the server and
    publishes on the channel; the centre is an embed following it, filled by
    the server too; the inspector is a vue reading it and publishing on it
    in turn. None of the three knows the others: the channel's name is all
    they share. The side regions are sized by the visitor, and come back at
    the width they were left at. -#}
{%- block page_body_container -%}
    {%- set channel = 'demo.workspace.slides' -%}
    {%- set first = slides|first -%}
    <div class="zone zone--split">
        {#- What scrolls is inside each side region: a region scrolling itself
            would clip the handle hanging into the gap beside it. -#}
        <div class="zone zone--narrow zone--size-5 zone--panel" {{ zone_state('demo.workspace.slides.rail') }}>
            {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer') }}
            <div class="zone zone--scrollable">
                <div class="zone--content workspace-slides--rail">
                    {#- A thumbnail is the slide itself, smaller: its number stands
                        beside it, in the page's own type. -#}
                    {%- for slide in slides -%}
                        <button type="button" class="workspace-slides--thumb" data-workspace-select="{{ slide }}">
                            <span class="workspace-slides--number">{{ loop.index }}</span>
                            {{ deck.slide(render_pass, ('@page::slide.' ~ slide ~ '.title') | trans, null, null, 'workspace-slides--preview') }}
                        </button>
                    {%- endfor -%}
                    {{ component(render_pass, '@WexampleSymfonyWorkspaceBundle/components/workspace-select', {
                        channel: channel,
                        source: 'rail',
                        initial: first,
                    }) }}
                </div>
            </div>
        </div>
        <div class="zone zone--scrollable zone--panel">
            {%- set embed = 'demo-workspace-slide' -%}
            {{ page_embed(embed, { src: path('workspace_demo_slide', { id: first }) }) }}
            {#- The path with a mark the id replaces: `{id}` itself would be
                escaped by the router. -#}
            {{ component(render_pass, '@WexampleSymfonyWorkspaceBundle/components/workspace-follow', {
                channel: channel,
                embed: embed,
                path: path('workspace_demo_slide', { id: '__id__' }) | replace({ '__id__': '{id}' }),
                current: first,
            }) }}
        </div>
        <div class="zone zone--narrow zone--size-6 zone--panel" {{ zone_state('demo.workspace.slides.inspector') }}>
            {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-resizer', {}, { edge: 'start' }) }}
            <div class="zone zone--scrollable">
                <div class="zone--content">
                    {%- set titles = {} -%}
                    {%- for slide in slides -%}
                        {%- set titles = titles|merge({ (slide): ('@page::slide.' ~ slide ~ '.title') | trans }) -%}
                    {%- endfor -%}
                    {{ vue(render_pass, '@WexampleSymfonyWorkspaceDemoBundle/components/demo-slide-inspector', {
                        channel: channel,
                        slides: slides,
                        titles: titles,
                        labels: {
                            title: '@page::inspector.title' | trans,
                            position: '@page::inspector.position' | trans,
                            previous: '@page::inspector.previous' | trans,
                            next: '@page::inspector.next' | trans,
                        },
                    }) }}
                </div>
            </div>
        </div>
    </div>
{%- endblock -%}
