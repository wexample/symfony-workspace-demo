{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_body -%}
    <div class="demo-widget-color">
        <button
                v-for="color in colors"
                :key="color"
                type="button"
                class="demo-widget-color--swatch"
                :class="{ 'is-selected': config.color === color }"
                :style="{ background: color }"
                :aria-label="color"
                :aria-pressed="config.color === color ? 'true' : 'false'"
                @click="choose(color)"
        ></button>
    </div>
{%- endblock -%}
